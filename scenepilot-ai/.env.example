# ── LLM API Keys ──────────────────────────────────────────────────────────────

GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=your_gemini_api_key_here

# ── IBM Granite Guardian (content safety gate) ────────────────────────────────
# Set GUARDIAN_ENABLED=true to activate the Guardian node in the pipeline.
# Requires a free IBM Cloud account + watsonx.ai project.
# Get your API key: https://cloud.ibm.com/iam/apikeys
# Get your project ID: https://dataplatform.cloud.ibm.com (Settings -> General)
GUARDIAN_ENABLED=false
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
# Risk score threshold 0.0-1.0 — scenes scoring above this are blocked.
GUARDIAN_THRESHOLD=0.8

# ── Story generation settings ─────────────────────────────────────────────────
# TOKEN_BUDGET_LIMIT: total token ceiling per pipeline run.
#   Small premise   (< 100 chars)  →  5,000  is usually enough
#   Standard premise (100–300 chars) →  10,000
#   Complex premise  (300–700 chars) →  20,000   (recommended for rich stories)
TOKEN_BUDGET_LIMIT=20000
MAX_RETRIES=3
# SCENE_MULTIPLIER: controls the pre-flight output-token estimate.
# Default 40 is calibrated to complex thriller/sci-fi premises (~18-22 scenes).
# Lower to 15-20 for educational/marketing genres with shorter outputs.
SCENE_MULTIPLIER=40

# ── Story store ───────────────────────────────────────────────────────────────
# Directory where generated stories are persisted as JSON files.
# Default: data/stories  (relative to repo root, auto-created on first run)
# STORY_STORE_DIR=data/stories

# ── LLM retry / backoff ───────────────────────────────────────────────────────
# Seconds to wait before retrying the same provider after a 429.
# Each provider gets 1 retry before the chain falls back to the next.
LLM_RETRY_DELAY=2.0

# ── Style Vault ───────────────────────────────────────────────────────────────
# Minimum cosine similarity for FAISS advisory flag (0.0-1.0).
# 0.20 is the calibrated floor for well-written prose vs sentence-level rules.
# Values above 0.30 will generate false positives on almost every scene.
STYLE_SIMILARITY_THRESHOLD=0.20

# ── Sandbox ───────────────────────────────────────────────────────────────────
# Set to "true" to use Docker sandbox (requires Docker daemon)
SANDBOX_USE_DOCKER=false
SANDBOX_DOCKER_IMAGE=python:3.11-slim

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── OpenTelemetry (optional Jaeger) ───────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
